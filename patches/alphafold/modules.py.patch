+# Multi-GPU GSPMD sharding support.
+# Set by RunModel.__init__ when num_gpus > 1; None disables sharding.
+_PAIR_SHARDING = None  # NamedSharding for (N_res, N_res, c_z)
+_MSA_SHARDING  = None  # NamedSharding for (N_seq, N_res, c_m)
+
+def _maybe_shard_pair(x):
+    if _PAIR_SHARDING is None:
+        return x
+    return jax.lax.with_sharding_constraint(x, _PAIR_SHARDING)
+
+def _maybe_shard_msa(x):
+    if _MSA_SHARDING is None:
+        return x
+    return jax.lax.with_sharding_constraint(x, _MSA_SHARDING)
